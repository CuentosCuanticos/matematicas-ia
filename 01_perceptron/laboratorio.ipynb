   "source": [
    "X_escalada=X.copy(); X_escalada[:,0]*=10\n",
    "w_s,b_s,errores_s,_=entrenar_perceptron(X_escalada,y,eta=.2)\n",
    "print('original:',errores)\n",
    "print('escalada:',errores_s)\n",
    "dibujar_frontera(X_escalada,y,w_s,b_s,'Primera característica ×10')"
